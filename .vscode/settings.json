// Editor appearance & behavior
{
  "editor.fontFamily": "'Fira Code', Consolas, 'Courier New', monospace",
  "editor.fontSize": 13,
  "editor.fontWeight": "normal",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.8,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.rulers": [80, 120],
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": false,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.scrollBeyondLastLine": false,
  "cSpell.enabled": false,
  "editor.guides.indentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.formatOnSaveMode": "modifications",
  "editor.codeLens": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // Code actions on save (JS/TS/HTML/CSS + geral)
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  // Files & autosave
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "node_modules": true,
    ".venv": true,
    "venv": true,
    ".vscode": false
  },

  // Search & Explorer
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "explorer.confirmDelete": false,
  "breadcrumbs.enabled": true,

  // Theme & icons
  "workbench.colorTheme": "Winter is Coming (Dark Blue - No Italics)",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.statusBar.visible": true,
  "workbench.editor.enablePreview": false,

  // Linters / Formatters
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.run": "onSave",
  "prettier.requireConfig": false,

  // Python
  "python.defaultInterpreterPath": "python",
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.formatting.provider": "black",
  "python.formatting.blackArgs": ["--line-length", "88"],
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.pylintEnabled": false,
  "python.terminal.executeInFileDir": true,
  "python.execution.environment": "terminal",
  "python.testing.pytestEnabled": true,

  // Code Runner & terminal behavior (garante input() e execução em pasta do arquivo)
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.shellIntegration.enabled": true,

  // Live Server (rápido testes front-end)
  "liveServer.settings.port": 5500,
  "liveServer.settings.wait": 500,
  "liveServer.settings.root": "/",

  // Git
  "git.autofetch": true,
  "git.enableSmartCommit": true,

  // Performance / telemetry
  "telemetry.telemetryLevel": "off",

  // Helpful UX settings for learning
  "workbench.startupEditor": "newUntitledFile",
  "files.hotExit": "onExitAndWindowClose",
  "debug.console.closeOnEnd": false,

  // HTML / CSS / JS niceties
  "html.validate.scripts": true,
  "css.validate": true,
  "javascript.validate.enable": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "vue-html": "html"
  },

  // Small extras
  "editor.inlineSuggest.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "extensions.ignoreRecommendations": false,
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python-envs.pythonProjects": []
}
