{
  // Editor appearance & behavior
  "editor.fontFamily": "'Fira Code', Consolas, 'Courier New', monospace",
  "editor.fontSize": 13,
  "editor.fontWeight": "normal",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.8,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "all",
  "editor.renderControlCharacters": false,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.scrollBeyondLastLine": false,
  "editor.guides.indentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.codeLens": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll": "always",
    "source.fixAll.eslint": "always"
  },

  // Files & autosave
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "node_modules": true,
    ".vscode": false
  },

  // Search & Explorer
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "explorer.confirmDelete": false,
  "breadcrumbs.enabled": true,

  // Theme & icons
  "workbench.colorTheme": "Tokyo Night",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.statusBar.visible": true,

  // Extensions / Linters / Formatters
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,

  // Python (adjust python.defaultInterpreterPath to the real path if needed)
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "python",
  "python.terminal.executeInFileDir": true,
  "python.execution.environment": "terminal",
  "python.testing.pytestEnabled": true,

  // Code Runner & terminal behavior (makes input() work)
  "code-runner.runInTerminal": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.shellIntegration.enabled": true,

  // Live Server (useful for HTML/CSS/JS rapid testing)
  "liveServer.settings.port": 5500,
  "liveServer.settings.wait": 500,

  // Git
  "git.autofetch": true,
  "git.enableSmartCommit": true,

  // Performance / telemetry
  "telemetry.telemetryLevel": "off",

  // Helpful UX settings for learning
  "workbench.startupEditor": "newUntitledFile",
  "files.hotExit": "onExitAndWindowClose",
  "debug.console.closeOnEnd": false,

  // Better Comments tags (kept from your previous config)
  "better-comments.tags": [
    { "tag": "!", "color": "#FF2D00" },
    { "tag": "?", "color": "#3498DB" },
    { "tag": "//", "color": "#474747", "strikethrough": true },
    { "tag": "todo", "color": "#FF8C00" },
    { "tag": "*", "color": "#98C379" }
  ],
  "CodeGPT.apiKey": "Anthropic",
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "python-envs.pythonProjects": []
}
